      "id": "cd109e5e-b0cd-4d4d-a7c8-23beae405729",
      "name": "Google Sheets Trigger",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 1,
      "position": [
        2880,
        832
      ],
      "credentials": {
        "googleSheetsTriggerOAuth2Api": {
          "id": "zQxUdQTmvHmPDF5W",
